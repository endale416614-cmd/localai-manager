import { ScrollView, LineEdit } from "std-widgets.slint";

// status: 0 stopped, 1 starting, 2 ready, 3 stopping, 4 failed, 5 launched
export struct AppTile {
    index: int,
    name: string,
    sub: string,
    port-label: string,
    status: int,
    status-label: string,
    stat: string,
    selected: bool,
}

export struct Fact {
    k: string,
    v: string,
}

export struct ChatRow {
    user: bool,
    text: string,
    thinking: string,
    error: string,
}

export struct PaletteItem {
    title: string,
    detail: string,
    status: int,
}

global Theme {
    out property <color> bg: #0F1113;
    out property <color> bar: #13161A;
    out property <color> panel: #16191D;
    out property <color> line: #23272D;
    out property <color> text: #E8EAED;
    out property <color> soft: #C3C8CE;
    out property <color> muted: #9AA1AA;
    out property <color> accent: #7CC4FF;
    out property <string> mono: "Cascadia Mono";

    public pure function status-color(s: int) -> color {
        if (s == 2 || s == 5) {
            return #3DD68C;
        }
        if (s == 1 || s == 3) {
            return #F5A524;
        }
        if (s == 4) {
            return #FF7A6B;
        }
        return #9AA1AA;
    }
}

component StatusDot inherits Rectangle {
    in property <int> status;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: status == 0 ? #5B636D : Theme.status-color(status);
    opacity: (status == 1 || status == 3) ? 0.3 + 0.7 * abs(sin(360deg * animation-tick() / 1.2s)) : 1.0;
    animate background { duration: 200ms; }
}

component Kbd inherits Rectangle {
    in property <string> text;
    height: 20px;
    width: t.preferred-width + 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3A4048;
    background: #22262B;
    t := Text {
        text: root.text;
        font-family: Theme.mono;
        font-size: 11px;
        color: Theme.soft;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

// kind: 0 neutral, 1 primary (green), 2 warning (amber), 3 ghost on amber
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;
    callback clicked;
    property <color> base: kind == 1 ? #3DD68C : kind == 2 ? #F5A524 : kind == 3 ? transparent : #22262B;
    height: 40px;
    min-width: label.preferred-width + 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: kind == 1 ? #3DD68C : kind == 2 ? #F5A524 : kind == 3 ? #6B5320 : #3A4048;
    background: ta.pressed ? base.darker(0.15) : ta.has-hover ? base.brighter(0.15) : base;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: (kind == 1 || kind == 2) ? 600 : 500;
        color: kind == 1 ? #06130C : kind == 2 ? #1A1300 : kind == 3 ? #E3D3B4 : Theme.text;
    }
}

component Meter inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> frac;
    in property <bool> hot;
    width: 200px;
    spacing: 6px;
    alignment: center;
    HorizontalLayout {
        Text { text: root.label; font-size: 12px; color: Theme.muted; }
        Rectangle { }
        Text { text: root.value; font-size: 12px; font-family: Theme.mono; color: Theme.text; }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.line;
        clip: true;
        Rectangle {
            x: 0;
            height: parent.height;
            width: parent.width * max(0, min(1, root.frac));
            border-radius: 3px;
            background: root.hot ? #FF7A6B : Theme.accent;
            animate width { duration: 450ms; easing: ease-out; }
            animate background { duration: 300ms; }
        }
    }
}

component Tile inherits Rectangle {
    in property <AppTile> data;
    callback clicked;
    border-radius: 10px;
    border-width: 1px;
    border-color: data.selected ? Theme.accent : ta.has-hover ? #343A42 : #262B31;
    background: data.selected ? #1A222B : ta.has-hover ? #1D2126 : Theme.panel;
    animate background, border-color { duration: 160ms; }
    accessible-role: button;
    accessible-label: data.name + ", " + data.status-label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding-top: 14px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; StatusDot { status: root.data.status; } }
            Text { text: root.data.name; font-size: 15px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.data.port-label; font-size: 12px; font-family: Theme.mono; color: Theme.muted; vertical-alignment: center; }
        }
        Text { text: root.data.sub; font-size: 12.5px; color: Theme.muted; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.data.status-label; font-size: 12px; font-weight: 500; color: Theme.status-color(root.data.status); horizontal-stretch: 1; overflow: elide; }
            Text { text: root.data.stat; font-size: 12px; font-family: Theme.mono; color: Theme.soft; }
        }
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <[AppTile]> tiles;
    callback select(int);
    property <int> cols: max(1, floor((root.width + 12px) / 242px));
    property <length> tile-w: (root.width - (cols - 1) * 12px) / cols;
    spacing: 12px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text { text: root.title; font-size: 12px; font-weight: 600; letter-spacing: 1px; color: Theme.soft; }
        Text { text: root.hint; font-size: 12px; color: Theme.muted; }
    }
    Rectangle {
        height: max(0px, ceil(root.tiles.length / root.cols) * 124px - 12px);
        for t[i] in root.tiles: Tile {
            x: mod(i, root.cols) * (root.tile-w + 12px);
            y: floor(i / root.cols) * 124px;
            width: root.tile-w;
            height: 112px;
            data: t;
            clicked => { root.select(t.index); }
        }
    }
}

component TabBtn inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 32px;
    width: tl.preferred-width + 28px;
    border-radius: 8px;
    background: active ? #23303D : ta.has-hover ? #1D2126 : transparent;
    animate background { duration: 120ms; }
    accessible-role: tab;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    tl := Text {
        text: root.text;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: root.active ? 600 : 500;
        color: root.active ? Theme.text : Theme.muted;
    }
}

component ChatView inherits VerticalLayout {
    in property <[ChatRow]> rows;
    in property <string> model;
    in property <int> status;
    in property <string> status-label;
    in property <string> start-label;
    in property <bool> ready;
    in property <bool> busy;
    in-out property <string> input;
    callback send(string);
    callback stop();
    callback clear();
    callback start-model();

    function submit() {
        if (root.ready && !root.busy && root.input != "") {
            root.send(root.input);
            root.input = "";
        }
    }

    padding: 24px;
    spacing: 14px;

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout { alignment: center; StatusDot { status: root.status; } }
        Text { text: root.model; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
        Text { text: root.status-label; font-size: 13px; color: Theme.status-color(root.status); vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if root.start-label != "": Btn { text: root.start-label; kind: 1; height: 34px; clicked => { root.start-model(); } }
        Btn { text: "New chat"; height: 34px; clicked => { root.clear(); } }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.panel;
        property <length> content-h: sv.content-height;
        // Follow the reply as it streams in.
        changed content-h => {
            sv.content-y = min(0px, sv.visible-height - sv.content-height);
        }
        sv := ScrollView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            VerticalLayout {
                width: sv.visible-width;
                padding: 20px;
                spacing: 16px;
                alignment: start;
                if root.rows.length == 0: Text {
                    text: root.ready ? "Ask " + root.model + " anything. It runs on this PC; nothing leaves 127.0.0.1." : "Start " + root.model + " to chat. Loading takes about a minute.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                for m in root.rows: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: m.user ? "You" : root.model;
                        font-size: 12px;
                        font-weight: 600;
                        color: m.user ? Theme.accent : #3DD68C;
                    }
                    if m.thinking != "": Text {
                        text: m.thinking;
                        font-size: 12px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    if m.text != "": TextInput {
                        text: m.text;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        color: m.user ? Theme.soft : Theme.text;
                        selection-background-color: #2F4A66;
                        accessible-role: text;
                    }
                    if m.error != "": Text {
                        text: m.error;
                        font-size: 13px;
                        color: #FFB4AA;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        LineEdit {
            horizontal-stretch: 1;
            height: 40px;
            font-size: 14px;
            text <=> root.input;
            enabled: root.ready;
            placeholder-text: root.ready ? "Message " + root.model + " (Enter to send)" : "Start the model first";
            accepted => { root.submit(); }
        }
        if root.busy: Btn { text: "Stop"; kind: 2; clicked => { root.stop(); } }
        if !root.busy: Btn { text: "Send"; kind: root.ready ? 1 : 0; clicked => { root.submit(); } }
    }
}

export component AppWindow inherits Window {
    title: "LocalAI";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 960px;
    min-height: 600px;
    // Flipped by Rust after a restore: a background one step off repaints the whole window.
    in property <bool> repaint-flip;
    background: root.repaint-flip ? #0F1114 : Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    forward-focus: keys;

    in property <[AppTile]> gpu-tiles;
    in property <[AppTile]> svc-tiles;
    in property <[AppTile]> app-tiles;
    in property <string> vram-label;
    in property <float> vram-frac;
    in property <string> ram-label;
    in property <float> ram-frac;
    in property <int> running-count;
    in property <string> config-error;

    in property <string> sel-name;
    in property <string> sel-sub;
    in property <int> sel-status;
    in property <string> sel-status-label;
    in property <[Fact]> sel-facts;
    in property <string> sel-note;
    in property <bool> sel-note-error;
    in property <string> primary-label;
    in property <int> primary-kind;
    in property <bool> can-open;
    in property <string> open-label: "Open in browser";
    in property <bool> can-restart;
    in property <string> log-text;
    in property <string> log-source;

    // Odysseus shown inside the window: Rust puts a WebView2 child window below the 48px web bar.
    in property <bool> web-open;
    in property <string> web-title;
    callback web-back();
    callback web-reload();
    callback web-layout();
    changed width => { root.web-layout(); }
    changed height => { root.web-layout(); }

    in property <bool> pending;
    in property <string> pending-text;
    in property <string> pending-cta;

    in-out property <bool> palette-open;
    in-out property <string> palette-query;
    in property <[PaletteItem]> palette-items;
    in-out property <int> palette-index;

    // 0 apps, 1 chat
    in-out property <int> tab: 0;
    in property <string> home;
    in property <[ChatRow]> chat-rows;
    in property <string> chat-model;
    in property <int> chat-status;
    in property <string> chat-status-label;
    in property <string> chat-start-label;
    in property <bool> chat-ready;
    in property <bool> chat-busy;
    in-out property <string> chat-input;

    callback select(int);
    callback primary();
    callback open-url();
    callback restart();
    callback confirm-switch();
    callback cancel-switch();
    callback query-edited(string);
    callback run-action(int);
    callback chat-send(string);
    callback chat-stop();
    callback chat-clear();
    callback chat-start();

    function open-palette() {
        root.palette-query = "";
        root.palette-index = 0;
        root.query-edited("");
        root.palette-open = true;
    }

    function close-palette() {
        root.palette-open = false;
        keys.focus();
    }

    keys := FocusScope {
        KeyBinding {
            keys: @keys(Control + K);
            // The web view is a native child window: the palette would open hidden under it.
            activated => {
                if (!root.web-open) {
                    root.open-palette();
                }
            }
        }

        capture-key-pressed(e) => {
            if (!root.palette-open) {
                return reject;
            }
            if (e.text == Key.Escape) {
                root.close-palette();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.palette-index = min(root.palette-index + 1, root.palette-items.length - 1);
                return accept;
            }
            if (e.text == Key.UpArrow) {
                root.palette-index = max(root.palette-index - 1, 0);
                return accept;
            }
            if (e.text == Key.Return) {
                if (root.palette-items.length > 0) {
                    root.run-action(root.palette-index);
                    root.close-palette();
                }
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Header
            Rectangle {
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 28px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 22px;
                                height: 22px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: Theme.accent;
                                stroke-width: 1.8px;
                                commands: "M8 5h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3z M9 1.5v3 M15 1.5v3 M9 19.5v3 M15 19.5v3 M1.5 9h3 M1.5 15h3 M19.5 9h3 M19.5 15h3 M9.5 12h5";
                            }
                        }
                        Text { text: "LocalAI"; font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        VerticalLayout { alignment: center; TabBtn { text: "Apps"; active: root.tab == 0; clicked => { root.tab = 0; } } }
                        VerticalLayout { alignment: center; TabBtn { text: "Chat"; active: root.tab == 1; clicked => { root.tab = 1; } } }
                    }
                    Rectangle {
                        height: 38px;
                        min-width: 240px;
                        max-width: 420px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: search-ta.has-hover ? #3A4048 : #2A2F35;
                        background: #1A1D21;
                        animate border-color { duration: 120ms; }
                        accessible-role: button;
                        accessible-label: "Search apps and actions";
                        accessible-action-default => { root.open-palette(); }
                        search-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-palette(); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 16px;
                                    height: 16px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    stroke: Theme.muted;
                                    stroke-width: 2px;
                                    commands: "M18 11a7 7 0 1 1-14 0a7 7 0 1 1 14 0z M20 20l-3.5-3.5";
                                }
                            }
                            Text { text: "Search apps and actions"; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Kbd { text: "Ctrl K"; } }
                        }
                    }
                    Rectangle { horizontal-stretch: 0.01; }
                    Meter { label: "GPU VRAM"; value: root.vram-label; frac: root.vram-frac; hot: root.vram-frac > 0.9; }
                    Meter { label: "System RAM"; value: root.ram-label; frac: root.ram-frac; hot: root.ram-frac > 0.85; }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            }

            if root.config-error != "": Rectangle {
                background: #2B1414;
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 24px;
                    Text { text: "apps.toml problem: " + root.config-error; color: #FFB4AA; wrap: word-wrap; }
                }
            }

            if root.tab == 1: ChatView {
                vertical-stretch: 1;
                rows: root.chat-rows;
                model: root.chat-model;
                status: root.chat-status;
                status-label: root.chat-status-label;
                start-label: root.chat-start-label;
                ready: root.chat-ready;
                busy: root.chat-busy;
                input <=> root.chat-input;
                send(t) => { root.chat-send(t); }
                stop => { root.chat-stop(); }
                clear => { root.chat-clear(); }
                start-model => { root.chat-start(); }
            }

            // Main
            if root.tab == 0: HorizontalLayout {
                padding: 24px;
                spacing: 24px;
                vertical-stretch: 1;
                sv-apps := ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        width: sv-apps.visible-width - 8px;
                        spacing: 28px;
                        alignment: start;
                        Section {
                            title: "GPU";
                            hint: "one at a time";
                            tiles: root.gpu-tiles;
                            select(i) => { root.select(i); }
                        }
                        Section {
                            title: "SERVICES";
                            hint: "CPU · background";
                            tiles: root.svc-tiles;
                            select(i) => { root.select(i); }
                        }
                        Section {
                            title: "APPS";
                            hint: "desktop and terminal · launch only";
                            tiles: root.app-tiles;
                            select(i) => { root.select(i); }
                        }
                    }
                }

                // Detail panel
                Rectangle {
                    width: 380px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Text { text: root.sel-name; font-size: 22px; font-weight: 600; color: Theme.text; }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #1F2328;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            VerticalLayout { alignment: center; StatusDot { status: root.sel-status; } }
                                            Text { text: root.sel-status-label; font-size: 12px; color: Theme.status-color(root.sel-status); vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                            Text { text: root.sel-sub; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                        }

                        if root.pending: Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #6B5320;
                            background: #241D10;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;
                                Text { text: "The GPU is busy"; font-weight: 600; color: #FFD58A; }
                                Text { text: root.pending-text; font-size: 13px; color: #E3D3B4; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Btn { text: root.pending-cta; kind: 2; clicked => { root.confirm-switch(); } }
                                    Btn { text: "Cancel"; kind: 3; clicked => { root.cancel-switch(); } }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            for f in root.sel-facts: HorizontalLayout {
                                spacing: 12px;
                                Text { text: f.k; width: 130px; font-size: 12px; color: Theme.muted; }
                                Text { text: f.v; font-size: 13px; font-family: Theme.mono; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }

                        if root.sel-note != "": Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: root.sel-note-error ? #5C2A26 : #24405C;
                            background: root.sel-note-error ? #2B1414 : #142130;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: root.sel-note; font-size: 13px; color: root.sel-note-error ? #FFB4AA : #C7DDF2; wrap: word-wrap; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { text: root.primary-label; kind: root.primary-kind; clicked => { root.primary(); } }
                            if root.can-open: Btn { text: root.open-label; clicked => { root.open-url(); } }
                            if root.can-restart: Btn { text: "Restart"; clicked => { root.restart(); } }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;
                            HorizontalLayout {
                                Text { text: "LOG"; font-size: 12px; font-weight: 600; letter-spacing: 1px; color: Theme.soft; }
                                Rectangle { }
                                Text { text: root.log-source; font-size: 11px; font-family: Theme.mono; color: Theme.muted; }
                            }
                            Rectangle {
                                // small minimum so the switch banner + note never push it past the panel
                                min-height: 72px;
                                vertical-stretch: 1;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.bg;
                                property <length> content-h: sv-log.content-height;
                                changed content-h => {
                                    sv-log.content-y = min(0px, sv-log.visible-height - sv-log.content-height);
                                }
                                sv-log := ScrollView {
                                    x: 1px;
                                    y: 1px;
                                    width: parent.width - 2px;
                                    height: parent.height - 2px;
                                    VerticalLayout {
                                        width: sv-log.visible-width;
                                        padding: 12px;
                                        Text {
                                            text: root.log-text;
                                            wrap: word-wrap;
                                            font-family: Theme.mono;
                                            font-size: 12px;
                                            color: Theme.soft;
                                            accessible-role: text;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Footer
            Rectangle {
                background: Theme.bar;
                Rectangle { y: 0; height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    Text { text: "Bound to 127.0.0.1 only · quitting the manager stops every app it started"; font-size: 12px; color: Theme.muted; }
                    Rectangle { }
                    Text { text: root.home + " · " + root.running-count + " running"; font-size: 12px; font-family: Theme.mono; color: Theme.muted; }
                }
            }
        }

        // Command palette
        if root.palette-open: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: #060809AD;
            TouchArea {
                clicked => { root.close-palette(); }
            }
            panel := Rectangle {
                width: min(580px, parent.width - 32px);
                height: pl.preferred-height;
                x: (parent.width - self.width) / 2;
                y: 96px;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2F353C;
                background: #1A1D21;
                drop-shadow-blur: 48px;
                drop-shadow-offset-y: 24px;
                drop-shadow-color: #00000080;
                clip: true;
                TouchArea { }
                pl := VerticalLayout {
                    HorizontalLayout {
                        height: 54px;
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 18px;
                                height: 18px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                stroke: Theme.muted;
                                stroke-width: 2px;
                                commands: "M18 11a7 7 0 1 1-14 0a7 7 0 1 1 14 0z M20 20l-3.5-3.5";
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.palette-query;
                                single-line: true;
                                font-size: 16px;
                                color: Theme.text;
                                vertical-alignment: center;
                                accessible-label: "Search apps and actions";
                                init => { self.focus(); }
                                edited => {
                                    root.palette-index = 0;
                                    root.query-edited(self.text);
                                }
                            }
                            if root.palette-query == "": Text {
                                x: 0;
                                text: "Type an app or action";
                                font-size: 16px;
                                color: Theme.muted;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: "Esc";
                                height: 32px;
                                clicked => { root.close-palette(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #2A2F35; }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        for it[i] in root.palette-items: Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: i == root.palette-index ? #23303D : row-ta.has-hover ? #262C33 : transparent;
                            accessible-role: button;
                            accessible-label: it.title;
                            accessible-action-default => {
                                root.run-action(i);
                                root.close-palette();
                            }
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.run-action(i);
                                    root.close-palette();
                                }
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                VerticalLayout { alignment: center; StatusDot { status: it.status; } }
                                Text { text: it.title; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: it.detail; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                if i == root.palette-index: VerticalLayout { alignment: center; Kbd { text: "Enter"; } }
                            }
                        }
                        if root.palette-items.length == 0: Text {
                            text: "No app or action matches \"" + root.palette-query + "\".";
                            color: Theme.muted;
                            height: 44px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: #2A2F35; }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 16px;
                        alignment: start;
                        Text { text: "↑ ↓ move"; font-size: 12px; color: Theme.muted; }
                        Text { text: "Enter run"; font-size: 12px; color: Theme.muted; }
                        Text { text: "Esc close"; font-size: 12px; color: Theme.muted; }
                    }
                }
            }
        }

        // Web bar; the web view fills everything below it.
        if root.web-open: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: Theme.bg;
            TouchArea { }
            Rectangle {
                y: 0;
                height: 48px;
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 12px;
                    Btn { text: "← Back to LocalAI"; height: 34px; clicked => { root.web-back(); } }
                    Text { text: root.web-title; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Btn { text: "Reload"; height: 34px; clicked => { root.web-reload(); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            }
            Text {
                y: 48px;
                height: parent.height - 48px;
                width: parent.width;
                text: "Loading " + root.web-title + "…";
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
